# Copy to .env for local development. Every setting is optional locally; defaults use
# SQLite in ./data and print emails to the console instead of sending them.

ENVIRONMENT=development
# DATABASE_URL=sqlite:///data/fxwatch.db
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate with: python -m fxwatch generate-secret
# Must be identical for the Streamlit app and the worker.
SECRET_KEY=

APP_BASE_URL=http://localhost:8501

# Email: "console" (log only) or "smtp".
MAIL_BACKEND=console
# Gmail: enable 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=FX Watch

LOG_LEVEL=INFO
LOG_FORMAT=text

# Tuning (defaults shown)
# CROSS_CHECK_TOLERANCE_PCT=2.0
# MAX_ACTIVE_ALERTS_PER_EMAIL=20
# BACKFILL_DAYS=3650
