# Streamlit Community Cloud → your app → Settings → Secrets. Paste these (filled in).
# Root-level keys are exposed to the app as environment variables.

ENVIRONMENT = "production"
DATABASE_URL = "postgresql://user:password@ep-xxxx.region.aws.neon.tech/fxwatch?sslmode=require"
SECRET_KEY = "same-value-as-the-github-actions-secret"
APP_BASE_URL = "https://your-app.streamlit.app"

MAIL_BACKEND = "smtp"
SMTP_USERNAME = "you@gmail.com"
SMTP_PASSWORD = "your-16-char-app-password"
MAIL_FROM_NAME = "FX Watch"
